<?xml version="1.0" encoding="utf-8"?>
<!-- NPC PHNPC : override de l'état faceTarget zombie.
     Le NPC reste en idle humain (Bob_Idle) au lieu de faire la rotation "zombie alarmé".
     Condition : PHNPC_IsNPC = true. -->
<animNode>
    <m_Name>PHNPC_FaceTarget</m_Name>
    <m_AnimName>Bob_Idle</m_AnimName>
    <m_deferredBoneAxis>Y</m_deferredBoneAxis>
    <m_SpeedScale>1.00</m_SpeedScale>
    <m_BlendTime>0.20</m_BlendTime>
    <m_Conditions>
        <m_Name>PHNPC_IsNPC</m_Name>
        <m_Type>BOOL</m_Type>
        <m_BoolValue>true</m_BoolValue>
    </m_Conditions>
</animNode>
