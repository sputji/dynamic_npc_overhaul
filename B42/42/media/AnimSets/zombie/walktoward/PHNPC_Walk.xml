<?xml version="1.0" encoding="utf-8"?>
<!-- NPC PHNPC : animation humaine marche (Bob_Walk) au lieu du shuffle zombie.
     Condition : PHNPC_IsNPC = true  ET  zombieWalkType = Walk.
     Si le NPC court (walkType=Run), c'est PHNPC_Run.xml qui prend le relais. -->
<animNode>
    <m_Name>PHNPC_Walk</m_Name>
    <m_AnimName>Bob_Walk</m_AnimName>
    <m_deferredBoneAxis>Y</m_deferredBoneAxis>
    <m_SpeedScale>0.90</m_SpeedScale>
    <m_BlendTime>0.20</m_BlendTime>
    <m_Conditions>
        <m_Name>PHNPC_IsNPC</m_Name>
        <m_Type>BOOL</m_Type>
        <m_BoolValue>true</m_BoolValue>
    </m_Conditions>
    <m_Conditions>
        <m_Name>zombieWalkType</m_Name>
        <m_Type>STRING</m_Type>
        <m_StringValue>Walk</m_StringValue>
    </m_Conditions>
    <m_Events>
        <m_EventName>Footstep</m_EventName>
        <m_TimePc>0.15</m_TimePc>
        <m_ParameterValue>walk</m_ParameterValue>
    </m_Events>
    <m_Events>
        <m_EventName>Footstep</m_EventName>
        <m_TimePc>0.60</m_TimePc>
        <m_ParameterValue>walk</m_ParameterValue>
    </m_Events>
</animNode>
