<?xml version="1.0" encoding="utf-8"?>
<!-- NPC PHNPC : animation humaine course (Bob_Run) quand le NPC court.
     Condition : PHNPC_IsNPC = true  ET  zombieWalkType = Run. -->
<animNode>
    <m_Name>PHNPC_Run</m_Name>
    <m_AnimName>Bob_Run</m_AnimName>
    <m_deferredBoneAxis>Y</m_deferredBoneAxis>
    <m_SpeedScale>1.00</m_SpeedScale>
    <m_BlendTime>0.15</m_BlendTime>
    <m_Conditions>
        <m_Name>PHNPC_IsNPC</m_Name>
        <m_Type>BOOL</m_Type>
        <m_BoolValue>true</m_BoolValue>
    </m_Conditions>
    <m_Conditions>
        <m_Name>zombieWalkType</m_Name>
        <m_Type>STRING</m_Type>
        <m_StringValue>Run</m_StringValue>
    </m_Conditions>
    <m_Events>
        <m_EventName>Footstep</m_EventName>
        <m_TimePc>0.10</m_TimePc>
        <m_ParameterValue>run</m_ParameterValue>
    </m_Events>
    <m_Events>
        <m_EventName>Footstep</m_EventName>
        <m_TimePc>0.55</m_TimePc>
        <m_ParameterValue>run</m_ParameterValue>
    </m_Events>
</animNode>
